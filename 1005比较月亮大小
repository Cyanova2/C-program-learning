#include <stdio.h>
int main()
{
    int n;
    scanf("%d", &n);
    int nums[105];
    int i;
    for(i = 0; i < n; i++)
    {
        scanf("%d", &nums[i]);
    }
    if(nums[n-1] == 0 || (nums[n-1] - nums[n-2] == 1 && nums[n-1] != 15))
    {
        printf("UP");
    }
    else if(nums[n-1] == 15 || (nums[n-2] - nums[n-1] == 1 && nums[n-1] != 0))
    {
        printf("DOWN");
    }
    else
    {
        printf("-1");
    }
    return 0;
}
