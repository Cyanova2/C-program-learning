#include<stdio.h>
#include<string.h>
#define MAX 200

int main()
{
    int T;
    scanf("%d",&T);
    while(T--){
        char a[MAX],b[MAX];
        scanf("%s %s",a,b);
        int len_a = strlen(a);
        int len_b = strlen(b);
        int res[2 * MAX] = {0};
        for(int i=len_a - 1; i >= 0; i--){
            for(int j=len_b - 1; j >= 0; j--){
                int num_a = a[i] - '0';
                int num_b = b[j] - '0';
                int sum = num_a * num_b + res[i+j+1];
                res[i+j+1] = sum % 10;
                res[i+j] = res[i+j] + sum / 10;
            }
        }
        int k = 0;
        while(k < len_a + len_b -1 && res[k] == 0){
            k++;
        }
        for(;k < len_a + len_b;k++){
            printf("%d",res[k]);
        }
        printf("\n");
    }
    return 0;
}
