#include <stdio.h>
#include <stdlib.h>

int cmp(const void *a, const void *b)
{
    int x = *(int *)a;
    int y = *(int *)b;
    if(x > y) return -1;
    else if(x < y) return 1;
    return 0;
}

int main()
{
    int n, k;
    scanf("%d %d", &n, &k);
    int A[100005], B[100005], d[100005];
    long long res = 0;
    for(int i = 0; i < n; i++)
    {
        scanf("%d", &A[i]);
    }
    for(int i = 0; i < n; i++)
    {
        scanf("%d", &B[i]);
        res += B[i]; 
        d[i] = A[i] - B[i];
    }
    qsort(d, n, sizeof(int), cmp);
    for(int i = 0; i < k; i++)
    {
        res += d[i];
    }
    printf("%lld", res);
    return 0;
}
