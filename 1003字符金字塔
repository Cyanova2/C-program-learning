#include <stdio.h>

int main() {
    char target; 
    scanf("%c", &target); 
    
    int n = target - 'A' + 1; 
    
    for (int i = 1; i <= n; i++) {
        
        for (int j = 1; j <= n - i; j++) {
            printf(" ");
        }
        
        for (char ch = 'A'; ch <= 'A' + i - 1; ch++) {
            printf("%c", ch);
        }
        
        for (char ch = 'A' + i - 2; ch >= 'A'; ch--) {
            printf("%c", ch);
        }
        
        printf("\n");
    }
    
    return 0;
}
