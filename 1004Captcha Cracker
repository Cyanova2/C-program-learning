#include<stdio.h>
#include<string.h>
int main(){
    int T;
    scanf("%d",&T);
    char s[100000]={0};
    int i;
    for(i=0;i<T;i++)
    {
        scanf("%s",s);
        int len=strlen(s);
        for(int i=0;i<len;i++)
        {
            if(s[i]=='z'&&s[i+1]=='e'&&s[i+2]=='r'&&s[i+3]=='o')
            {
                printf("0");
            }
            else if(s[i]=='t'&&s[i+1]=='w'&&s[i+2]=='o')
            {
                printf("2");
            }
            else if(s[i]=='f'&&s[i+1]=='o'&&s[i+2]=='u'&&s[i+3]=='r')
            {
                printf("4");
            }
            else if(s[i]=='s'&&s[i+1]=='i'&&s[i+2]=='x')
            {
                printf("6");
            }
            else if(s[i]=='n'&&s[i+1]=='i'&&s[i+2]=='n'&&s[i+3]=='e')
            {
                printf("9");
            }
            else if(s[i]=='0'||s[i]=='2'||s[i]=='4'||s[i]=='6'||s[i]=='9')
            {
                printf("%c",s[i]);
            }
        }
        printf("\n");
    }
    return 0;
}
